# 基础服务监听配置
APP_HOST=0.0.0.0
APP_PORT=3000

# WebSocket 出站编码策略（json / auto / msgpack）
WS_MESSAGE_CODEC=json

# 房间快照格式（json / msgpack）
ROOM_SNAPSHOT_FORMAT=json

# OCR 代理配置（请复制为 backend/.env 后填写）
# 示例：
#   cp backend/.env.example backend/.env

# 必填：OCR 服务完整 URL（例如 https://api.xxx.com/v1/ocr/latex）
# OpenAI 兼容模式下可直接填根路径（例如 https://api.xxx.com/v1），后端会自动补全为 /chat/completions
OCR_BASE_URL=

# 必填：OCR 服务密钥
OCR_API_KEY=

# 可选：认证头名称（默认 Authorization）
OCR_AUTH_HEADER=Authorization

# 可选：认证方案（默认 Bearer；设置为 none 表示仅发送密钥本身）
OCR_AUTH_SCHEME=Bearer

# 可选：OCR 模型名
OCR_MODEL=

# 可选：请求格式（auto/custom/openai）
# - auto: 根据 OCR_BASE_URL 自动判断；若以 /v1 结尾会走 OpenAI chat/completions
# - custom: 使用 {image,mimeType,task,model} 格式
# - openai: 使用 OpenAI 兼容 chat/completions 多模态格式
OCR_REQUEST_FORMAT=auto

# 可选：超时（毫秒）
OCR_TIMEOUT_MS=15000

# 可选：返回给前端的 provider 标识
OCR_PROVIDER=custom
