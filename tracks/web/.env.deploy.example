# Whiteboard cloud deployment environment template
# Usage:
#   cp .env.deploy.example .env
#   docker compose --env-file .env config
#   docker compose --env-file .env up -d --build
#
# This file is for docker compose deployment in the web host line.
# Do NOT commit the real `.env` if it contains secrets.

#######################################
# Backend service runtime
#######################################

# Backend bind host inside container.
# Usually keep `0.0.0.0`.
APP_HOST=0.0.0.0

# Backend bind port inside container.
# Usually keep `3000`.
APP_PORT=3000

# Backend outbound WebSocket encoding policy.
# Allowed:
# - json: safest default
# - auto: experimental, broadcast may use binary
# - msgpack: force binary outbound
WS_MESSAGE_CODEC=json

# Snapshot persistence format.
# Allowed: json / msgpack
ROOM_SNAPSHOT_FORMAT=json

#######################################
# OCR upstream
#######################################

# Required if you want OCR / LaTeX recognition to work.
# Example:
# OCR_BASE_URL=https://your-provider.example.com/v1
OCR_BASE_URL=

# Required with OCR_BASE_URL.
OCR_API_KEY=

# Optional auth header name.
# Usually keep `Authorization`.
OCR_AUTH_HEADER=Authorization

# Optional auth scheme.
# Usually keep `Bearer`.
# Set to `none` if the upstream expects raw token only.
OCR_AUTH_SCHEME=Bearer

# Optional OCR model name.
# Required when OCR_REQUEST_FORMAT=openai or when your upstream demands a model.
OCR_MODEL=

# Allowed: auto / custom / openai
# - auto: infer from OCR_BASE_URL
# - custom: send custom payload
# - openai: send OpenAI-compatible chat/completions payload
OCR_REQUEST_FORMAT=auto

# Optional timeout in milliseconds.
OCR_TIMEOUT_MS=15000

# Optional provider label returned to frontend.
OCR_PROVIDER=custom

#######################################
# Frontend production build args
#######################################

# Leave empty in the default split-port deployment.
# Only set this if frontend must call an explicit API origin.
# Same-origin reverse-proxy deployments can also leave this empty.
# Example:
# VITE_API_BASE_URL=https://whiteboard.example.com
VITE_API_BASE_URL=

# Leave empty in the default split-port deployment.
# Only set this if websocket must connect to a dedicated host.
# Same-origin reverse-proxy deployments can also leave this empty.
# Example:
# VITE_WS_BASE_URL=wss://whiteboard.example.com
VITE_WS_BASE_URL=

# Optional frontend origin hint.
# Currently reserved for future use; usually leave empty.
VITE_FRONTEND_ORIGIN=

# Frontend control-message codec default.
# Usually keep `json`.
VITE_WS_MESSAGE_CODEC=json

# Frontend high-frequency layerOp codec default.
# Usually keep `msgpack`.
VITE_WS_LAYER_OP_CODEC=msgpack

#######################################
# Frontend dev-only values
#######################################

# These are only useful for local Vite development.
# They do not matter for the production nginx container.

VITE_DEV_PROXY_TARGET=http://localhost:3000
# Optional extra dev hosts for Vite, comma-separated.
# Leave empty unless you really need to access the dev server via a custom hostname.
VITE_DEV_ALLOWED_HOSTS=
