# Development proxy target used by Vite dev server.
VITE_DEV_PROXY_TARGET=http://localhost:3000

# Comma-separated list for Vite dev allowed hosts.
# Leave empty unless you need a custom hostname for Vite dev access.
VITE_DEV_ALLOWED_HOSTS=

# Optional runtime overrides.
# Leave empty if you want the frontend to use same-origin paths.
# Fill these only for explicit split-port or cross-origin deployment.
# These values are also used as Docker build args for the production frontend image.
VITE_API_BASE_URL=
VITE_WS_BASE_URL=
VITE_FRONTEND_ORIGIN=

# WebSocket client codec controls.
VITE_WS_MESSAGE_CODEC=json
VITE_WS_LAYER_OP_CODEC=msgpack
